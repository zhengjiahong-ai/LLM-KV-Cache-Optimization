    "family": "DOWNSTREAM_VICTIM_AWARE_ENTRY_RELEASE",
    "foundation": "CONTINUUM_ADAPTED",
    "not_a1_a3_a2_selection": true,
    "mechanism": "At each forced Entry Release decision, simulate the actual Native LRU victim blocks V(X) for each legal candidate X on the same eligible state; score X by the future-reuse risk of V(X), using only pre-decision active follow-up chains and tool-gap state; release the lowest-risk candidate; tie-break to A0.",
    "score_contract": {
      "victim_set": "simulated_counterfactual_victim_set(X)",
      "weight": "1 for blocks on an active follow-up chain with a pending tool gap inside H; 0 otherwise",
      "loss": "sum(weight(block) for block in victim_set(X))",
      "selection": "min(loss, A0_tie_break)",
      "future_information_used": false,
      "native_lru_semantics_preserved": true
    },
    "evidence_basis": [
      "Phase 2D local shared-protected headroom",
      "Phase 3 A1/A3 target/eviction-set misalignment",
      "Phase 3 A2 no victim-sequence divergence",
      "P2 no positive decision value",
      "P1/E1-A exposure/data-gap findings",
      "Phase 4 requirement to target actual downstream victim set"
    ],
    "selection_gate": {
