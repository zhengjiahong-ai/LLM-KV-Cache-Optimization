{
  "schema_version": "phase5.metrics.v1",
  "protocol_id": "phase5-formal-six-system-trace-replay-v1",
  "independent_unit": "WORKLOAD_GROUP",
  "clock_domains": [
    "LOGICAL_REPLAY",
    "CLIENT_DISPATCH",
    "ENGINE_CORE",
    "FRONTEND_OUTPUT",
    "NATIVE_TERMINAL",
    "WALL_MONOTONIC"
  ],
  "timing_contract": {
    "ttft_origin": "CLIENT_DISPATCH_ACCEPTED",
    "ttft_end": "FIRST_OUTPUT_TOKEN",
    "arrival_to_first_token_reported_separately": true,
    "queue_delay_reported_separately": true,
    "throughput_denominator": "OBSERVED_WINDOW_FIRST_ARRIVAL_TO_LAST_OBSERVED_TERMINAL",
    "completion_time": "ONLY_IF_ALL_SCHEDULED_REQUESTS_TERMINAL_ELSE_CENSORED_INCOMPLETE",
    "right_censored_sessions_do_not_add_future_requests": true
  },
  "metrics": [
    {
      "id": "recomputed_tokens_E_minus_C",
      "role": "PRIMARY",
      "name": "Recomputed eligible-prefix tokens",
      "formula": "sum_over_requests(E - C)",
      "unit": "tokens",
      "level": "RUN_THEN_WORKLOAD_GROUP",
      "numerator": "E - C for every qualified request",
      "denominator": "not_applicable_sum_metric",
      "aggregation": "sum requests within run; mean repeats within Group/System; paired contrast at Group",
      "missing_policy": "FAIL_CLOSED_GROUP_INCOMPLETE",
      "source": "INDEPENDENT_N_E_C_EVALUATOR",
      "direction": "LOWER_IS_BETTER",
      "claim_class": "SYSTEM_AND_MECHANISM"
    },
    {
      "id": "actual_prefill_tokens_N_minus_C",
      "role": "SECONDARY",
      "name": "Actual prefill tokens",
      "formula": "sum_over_requests(N - C)",
      "unit": "tokens",
      "level": "RUN_THEN_WORKLOAD_GROUP",
      "numerator": "N - C",
      "denominator": "not_applicable_sum_metric",
      "aggregation": "sum requests within run; mean repeats; paired contrast",
      "missing_policy": "FAIL_CLOSED_GROUP_INCOMPLETE",
      "source": "INDEPENDENT_N_E_C_EVALUATOR",
      "direction": "LOWER_IS_BETTER",
      "claim_class": "SECONDARY_NOT_A_SUBSTITUTE_FOR_E_MINUS_C"
    },
    {
      "id": "ttft_ms",
      "role": "SECONDARY",
      "name": "Time to first token",
      "formula": "first_output_token_timestamp - CLIENT_DISPATCH_ACCEPTED_timestamp",
      "unit": "milliseconds",
      "level": "REQUEST_THEN_GROUP",
      "numerator": "observed first-token interval from dispatch acceptance",
      "denominator": "observed requests with valid timestamps",
      "aggregation": "request P50/P95 within Group/System; repeats averaged",
      "missing_policy": "REPORT_OBSERVED_ONLY_NO_IMPUTATION",
      "source": "CLIENT_DISPATCH_AND_NATIVE_OUTPUT_TIMESTAMPS",
      "direction": "LOWER_IS_BETTER",
      "claim_class": "SERVING"
    },
    {
      "id": "request_latency_p50_ms",
      "role": "SECONDARY",
      "name": "End-to-end request latency P50",
      "formula": "median(terminal_timestamp - arrival_timestamp)",
      "unit": "milliseconds",
      "level": "REQUEST_THEN_GROUP",
      "numerator": "observed request intervals",
      "denominator": "observed requests",
      "aggregation": "P50 per run; repeats averaged; Group-level contrast",
      "missing_policy": "REPORT_OBSERVED_ONLY_NO_IMPUTATION",
      "source": "NATIVE_AND_FRONTEND_TIMESTAMPS",
      "direction": "LOWER_IS_BETTER",
      "claim_class": "SERVING"
    },
    {
      "id": "request_latency_p95_ms",
      "role": "SECONDARY",
      "name": "End-to-end request latency P95",
      "formula": "95th_percentile(terminal_timestamp - arrival_timestamp)",
      "unit": "milliseconds",
      "level": "REQUEST_THEN_GROUP",
      "numerator": "observed request intervals",
      "denominator": "observed requests",
      "aggregation": "P95 per run; repeats averaged; Group-level contrast",
      "missing_policy": "REPORT_OBSERVED_ONLY_NO_IMPUTATION",
      "source": "NATIVE_AND_FRONTEND_TIMESTAMPS",
      "direction": "LOWER_IS_BETTER",
      "claim_class": "SERVING"
    },
    {
      "id": "throughput_requests_per_second",
      "role": "SECONDARY",
      "name": "Request throughput",
      "formula": "completed_requests / run_wall_seconds",
      "unit": "requests/second",
      "level": "RUN",
      "numerator": "completed qualified requests",
      "denominator": "observed window from first arrival to last observed terminal; right-censored future requests excluded",
      "aggregation": "run value; repeats averaged; Group-level contrast",
      "missing_policy": "FAIL_CLOSED_IF_COMPLETION_UNCERTAIN",
      "source": "NATIVE_TERMINAL_AND_WALL_CLOCK",
      "direction": "HIGHER_IS_BETTER",
      "claim_class": "SERVING"
    },
    {
      "id": "throughput_tokens_per_second",
      "role": "SECONDARY",
      "name": "Generated token throughput",
      "formula": "generated_tokens / run_wall_seconds",
      "unit": "tokens/second",
      "level": "RUN",
      "numerator": "generated tokens",
      "denominator": "run wall-clock duration",
      "aggregation": "run value; repeats averaged",
      "missing_policy": "REPORT_OBSERVED_ONLY",
      "source": "OUTPUT_TOKEN_EVIDENCE",
      "direction": "HIGHER_IS_BETTER",
      "claim_class": "SERVING"
    },
    {
      "id": "completion_time_ms",
      "role": "SECONDARY",
      "name": "Campaign-run completion time",
      "formula": "last_observed_terminal_timestamp - first_arrival_timestamp",
      "unit": "milliseconds",
      "level": "RUN",
      "numerator": "run completion duration",
      "denominator": "one run",
      "aggregation": "only when all scheduled requests terminal; otherwise CENSORED_INCOMPLETE, not imputed",
      "missing_policy": "FAIL_CLOSED_IF_TERMINAL_UNCERTAIN",
      "source": "DUAL_TERMINAL_LIFECYCLE",
      "direction": "LOWER_IS_BETTER",
      "claim_class": "SERVING"
    },
    {
      "id": "cache_reuse_ratio_C_over_E",
      "role": "SECONDARY",
      "name": "Native cache reuse ratio over eligible prefix",
      "formula": "C / E",
      "unit": "ratio",
      "level": "REQUEST_THEN_RUN",
      "numerator": "C",
      "denominator": "E where E > 0",
      "aggregation": "request ratio; Group/System weighted by E or reported separately",
      "missing_policy": "NOT_APPLICABLE_WHEN_E_ZERO",
      "source": "INDEPENDENT_N_E_C_EVALUATOR",
      "direction": "HIGHER_IS_BETTER",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "cache_reuse_ratio_C_over_N",
      "role": "SECONDARY",
      "name": "Native cache reuse ratio over prompt",
      "formula": "C / N",
      "unit": "ratio",
      "level": "REQUEST_THEN_RUN",
      "numerator": "C",
      "denominator": "N where N > 0",
      "aggregation": "request ratio; Group/System weighted by N or reported separately",
      "missing_policy": "NOT_APPLICABLE_WHEN_N_ZERO",
      "source": "INDEPENDENT_N_E_C_EVALUATOR",
      "direction": "HIGHER_IS_BETTER",
      "claim_class": "DIAGNOSTIC_NOT_A_HIT_RATE"
    },
    {
      "id": "gpu_memory_peak_mib",
      "role": "SECONDARY",
      "name": "Peak GPU memory",
      "formula": "max(sampled_allocated_and_reserved_memory)",
      "unit": "MiB",
      "level": "RUN",
      "numerator": "peak sampled memory",
      "denominator": "one run",
      "aggregation": "run peak; repeats max/median reported",
      "missing_policy": "FAIL_CLOSED_IF_SAMPLER_UNAVAILABLE",
      "source": "GPU_MEMORY_SAMPLER",
      "direction": "LOWER_IS_BETTER",
      "claim_class": "RESOURCE"
    },
    {
      "id": "admission_queue_length",
      "role": "SECONDARY",
      "name": "Admission queue length",
      "formula": "max(queued_requests)",
      "unit": "requests",
      "level": "RUN",
      "numerator": "queued requests",
      "denominator": "one run",
      "aggregation": "peak and time-weighted mean per run",
      "missing_policy": "FAIL_CLOSED_IF_QUEUE_STATE_NOT_OBSERVABLE",
      "source": "NATIVE_SCHEDULER_EVIDENCE",
      "direction": "LOWER_IS_BETTER",
      "claim_class": "SERVING"
    },
    {
      "id": "peak_native_inflight",
      "role": "SECONDARY",
      "name": "Peak Native inflight requests",
      "formula": "max(active Native request IDs)",
      "unit": "requests",
      "level": "RUN",
      "numerator": "Native-submitted and not-Native-terminal requests",
      "denominator": "one run",
      "aggregation": "run peak; repeats averaged",
      "missing_policy": "FAIL_CLOSED_IF_IDENTITY_INCOMPLETE",
      "source": "NATIVE_LIFECYCLE_EVIDENCE",
      "direction": "CONTEXTUAL",
      "claim_class": "CONCURRENCY"
    },
    {
      "id": "policy_overhead_ms_per_decision",
      "role": "SECONDARY",
      "name": "Policy CPU overhead",
      "formula": "sum(policy_cpu_seconds_per_decision) / decision_count * 1000",
      "unit": "milliseconds/decision",
      "level": "RUN",
      "numerator": "policy CPU time",
      "denominator": "valid policy decisions",
      "aggregation": "run value; repeats averaged",
      "missing_policy": "FAIL_CLOSED_IF_POLICY_TIMER_MISSING",
      "source": "POLICY_TIMER",
      "direction": "LOWER_IS_BETTER",
      "claim_class": "OVERHEAD"
    },
    {
      "id": "candidate_exposure_count",
      "role": "DIAGNOSTIC",
      "name": "Candidate exposure",
      "formula": "count(decisions), count(multi_candidate), count(fully_scored)",
      "unit": "decisions",
      "level": "DECISION_THEN_GROUP",
      "numerator": "decision-level counts",
      "denominator": "valid decisions",
      "aggregation": "descriptive counts by Group/System",
      "missing_policy": "NOT_OBSERVABLE_IS_FAIL_CLOSED_FOR_JOIN",
      "source": "CANDIDATE_EXPOSURE_EVALUATOR",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "decision_divergence_count",
      "role": "DIAGNOSTIC",
      "name": "Decision divergence",
      "formula": "count(identical_state_pairs_with_different_selection)",
      "unit": "decisions",
      "level": "DECISION_PAIR_THEN_GROUP",
      "numerator": "divergent decisions",
      "denominator": "comparable decision pairs",
      "aggregation": "descriptive counts",
      "missing_policy": "FAIL_CLOSED_IF_STATE_IDENTITY_INCOMPLETE",
      "source": "DECISION_LEDGER",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "matched_physical_victim_blocks",
      "role": "DIAGNOSTIC",
      "name": "Matched physical victim blocks",
      "formula": "count(planned_victim_blocks matched to physical evictions)",
      "unit": "blocks",
      "level": "DECISION_THEN_GROUP",
      "numerator": "matched blocks",
      "denominator": "planned victim blocks",
      "aggregation": "counts and ratios",
      "missing_policy": "UNMATCHED_IS_EXPLICIT_NOT_ZERO",
      "source": "PHYSICAL_OUTCOME_EVIDENCE",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "unmatched_physical_victim_blocks",
      "role": "DIAGNOSTIC",
      "name": "Unmatched physical victim blocks",
      "formula": "count(observed physical evictions outside the SelectionPlan)",
      "unit": "blocks",
      "level": "DECISION_THEN_GROUP",
      "numerator": "unmatched blocks",
      "denominator": "observed physical evictions",
      "aggregation": "counts and ratios",
      "missing_policy": "NEVER_IMPUTED_AS_ZERO",
      "source": "PHYSICAL_OUTCOME_EVIDENCE",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "downstream_reuse_opportunity_count",
      "role": "DIAGNOSTIC",
      "name": "Downstream reuse opportunity",
      "formula": "count(later requests touching a candidate chain)",
      "unit": "requests",
      "level": "DECISION_THEN_GROUP",
      "numerator": "observed downstream touches",
      "denominator": "candidate decisions",
      "aggregation": "descriptive",
      "missing_policy": "DESCRIPTIVE_ONLY",
      "source": "REQUEST_AND_CHAIN_EVIDENCE",
      "direction": "CONTEXTUAL",
      "claim_class": "DESCRIPTIVE_NOT_CAUSAL"
    },
    {
      "id": "legal_candidate_count_distribution",
      "role": "DIAGNOSTIC",
      "name": "Legal candidate count distribution",
      "formula": "distribution of |legal candidates| per decision",
      "unit": "decisions",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "distribution of |legal candidates| per decision",
      "denominator": "valid decisions or comparable pairs",
      "aggregation": "descriptive Stage 1 counts/rates by Group and algorithm",
      "missing_policy": "FAIL_CLOSED_FOR_EVIDENCE_JOIN; MISSING_NOT_ZERO",
      "source": "UNIFIED_CANDIDATE_EVALUATION_SNAPSHOT",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "multi_candidate_decision_rate",
      "role": "DIAGNOSTIC",
      "name": "Multi-candidate decision rate",
      "formula": "decisions with >=2 fully scored legal candidates / valid decisions",
      "unit": "ratio",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "decisions with >=2 fully scored legal candidates / valid decisions",
      "denominator": "valid decisions or comparable pairs",
      "aggregation": "descriptive Stage 1 counts/rates by Group and algorithm",
      "missing_policy": "FAIL_CLOSED_FOR_EVIDENCE_JOIN; MISSING_NOT_ZERO",
      "source": "UNIFIED_CANDIDATE_EVALUATION_SNAPSHOT",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "candidate_score_distribution",
      "role": "DIAGNOSTIC",
      "name": "Candidate score distribution",
      "formula": "per-candidate score distribution by algorithm and snapshot",
      "unit": "score",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "per-candidate score distribution by algorithm and snapshot",
      "denominator": "valid decisions or comparable pairs",
      "aggregation": "descriptive Stage 1 counts/rates by Group and algorithm",
      "missing_policy": "FAIL_CLOSED_FOR_EVIDENCE_JOIN; MISSING_NOT_ZERO",
      "source": "UNIFIED_CANDIDATE_EVALUATION_SNAPSHOT",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "pairwise_rank_inversion",
      "role": "DIAGNOSTIC",
      "name": "Pairwise rank inversion",
      "formula": "pairs whose candidate order differs between algorithms",
      "unit": "pairs",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "pairs whose candidate order differs between algorithms",
      "denominator": "valid decisions or comparable pairs",
      "aggregation": "descriptive Stage 1 counts/rates by Group and algorithm",
      "missing_policy": "FAIL_CLOSED_FOR_EVIDENCE_JOIN; MISSING_NOT_ZERO",
      "source": "UNIFIED_CANDIDATE_EVALUATION_SNAPSHOT",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "selection_divergence",
      "role": "DIAGNOSTIC",
      "name": "Selection divergence",
      "formula": "same snapshot, different selected candidate identity",
      "unit": "decisions",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "same snapshot, different selected candidate identity",
      "denominator": "valid decisions or comparable pairs",
      "aggregation": "descriptive Stage 1 counts/rates by Group and algorithm",
      "missing_policy": "FAIL_CLOSED_FOR_EVIDENCE_JOIN; MISSING_NOT_ZERO",
      "source": "UNIFIED_CANDIDATE_EVALUATION_SNAPSHOT",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "victim_set_divergence",
      "role": "DIAGNOSTIC",
      "name": "Victim set divergence",
      "formula": "same snapshot, different Native LRU victim set or sequence",
      "unit": "decisions",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "same snapshot, different Native LRU victim set or sequence",
      "denominator": "valid decisions or comparable pairs",
      "aggregation": "descriptive Stage 1 counts/rates by Group and algorithm",
      "missing_policy": "FAIL_CLOSED_FOR_EVIDENCE_JOIN; MISSING_NOT_ZERO",
      "source": "UNIFIED_CANDIDATE_EVALUATION_SNAPSHOT",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "decision_branch_coverage",
      "role": "DIAGNOSTIC",
      "name": "Decision branch coverage",
      "formula": "observed A1 branch/step coverage by algorithm",
      "unit": "branches",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "observed A1 branch/step coverage by algorithm",
      "denominator": "valid decisions or comparable pairs",
      "aggregation": "descriptive Stage 1 counts/rates by Group and algorithm",
      "missing_policy": "FAIL_CLOSED_FOR_EVIDENCE_JOIN; MISSING_NOT_ZERO",
      "source": "UNIFIED_CANDIDATE_EVALUATION_SNAPSHOT",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "evidence_coverage",
      "role": "DIAGNOSTIC",
      "name": "Evidence coverage",
      "formula": "decisions with all required evidence / valid decisions",
      "unit": "ratio",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "decisions with all required evidence / valid decisions",
      "denominator": "valid decisions or comparable pairs",
      "aggregation": "descriptive Stage 1 counts/rates by Group and algorithm",
      "missing_policy": "FAIL_CLOSED_FOR_EVIDENCE_JOIN; MISSING_NOT_ZERO",
      "source": "UNIFIED_CANDIDATE_EVALUATION_SNAPSHOT",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "fallback_rate",
      "role": "DIAGNOSTIC",
      "name": "Fallback rate",
      "formula": "decisions using a declared fallback / valid decisions",
      "unit": "ratio",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "decisions using a declared fallback / valid decisions",
      "denominator": "valid decisions or comparable pairs",
      "aggregation": "descriptive Stage 1 counts/rates by Group and algorithm",
      "missing_policy": "FAIL_CLOSED_FOR_EVIDENCE_JOIN; MISSING_NOT_ZERO",
      "source": "UNIFIED_CANDIDATE_EVALUATION_SNAPSHOT",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "physical_victim_sequence",
      "role": "DIAGNOSTIC",
      "name": "Physical victim sequence",
      "formula": "ordered Native LRU victim sequence after the Entry decision",
      "unit": "blocks",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "ordered Native LRU victim sequence after the Entry decision",
      "denominator": "observed decisions or requests",
      "aggregation": "descriptive Stage 2 evidence; no local-gain summation",
      "missing_policy": "FAIL_CLOSED_IF_IDENTITY_INCOMPLETE",
      "source": "NATIVE_VICTIM_AND_REQUEST_EVIDENCE",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    },
    {
      "id": "downstream_reuse",
      "role": "DIAGNOSTIC",
      "name": "Downstream reuse",
      "formula": "later observed request touching a victim/candidate chain",
      "unit": "requests",
      "level": "DECISION_THEN_WORKLOAD_GROUP",
      "numerator": "later observed request touching a victim/candidate chain",
      "denominator": "observed decisions or requests",
      "aggregation": "descriptive Stage 2 evidence; no local-gain summation",
      "missing_policy": "FAIL_CLOSED_IF_IDENTITY_INCOMPLETE",
      "source": "NATIVE_VICTIM_AND_REQUEST_EVIDENCE",
      "direction": "CONTEXTUAL",
      "claim_class": "MECHANISM_DIAGNOSTIC"
    }
  ],
  "causal_boundary": {
    "physical_causal_attribution": "NOT_ESTABLISHED",
    "downstream_recompute_attribution": "NOT_ESTABLISHED",
    "do_not_convert_association_to_causality": true
  },
  "candidate_evaluation_contract": "phase5.candidate_evaluation.v1",
  "candidate_evaluation_stages": [
    "STAGE_1_DECISION_SPACE",
    "STAGE_2_FULL_TRAJECTORY_COUNTERFACTUAL",
    "STAGE_3_MECHANISM_CORRECTNESS"
  ]
}
