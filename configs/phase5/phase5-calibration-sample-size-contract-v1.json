    "pooled_calibration_groups": 8,
    "pooled_df": 7,
    "per_stratum_df": 3,
    "low_df_warning": "Per-stratum variance with 4 Groups has df=3; report its uncertainty and prefer pooled variance when homogeneity is not rejected.",
    "contrast_covariance": "3x3 covariance of Cost-Aware-minus-baseline Group differences; used for simulation sensitivity; sample-size uses the maximum per-contrast variance as a conservative scalar",
    "no_repeat_as_independent_group": true
  },
  "mde": {
    "absolute_min_tokens": 512,
    "relative_fraction_of_native_group_mean": 0.05,
    "rule": "max(512, 0.05 * calibration_native_group_mean_recomputed_tokens)",
    "pre_registration_order": [
      "FREEZE_FORMULA_AND_FLOOR_BEFORE_CALIBRATION",
      "COMPUTE_MDE_VALUE_FROM_CALIBRATION_NATIVE_GROUP_MEAN",
      "FREEZE_MDE_VALUE_BEFORE_FORMAL"
    ],
    "mde_value_status": "NOT_COMPUTED_UNTIL_CALIBRATION"
  },
  "power": {
    "alpha_family": 0.05,
    "two_sided": true,
    "power": 0.8,
    "primary_contrasts": 5,
    "strata": 2,
    "multiplicity_family": "FIVE_CANDIDATE_CONTRASTS_PER_STRATUM",
    "family_size": 5,
    "multiplicity": "HOLM_WITHIN_EACH_FAMILY_PER_STRATUM",
    "initial_conservative_alpha_per_test": 0.01,
    "system_context_family": "NATIVE_vs_A0_AND_OFFICIAL_vs_A0_PER_STRATUM"
  },
  "sample_size_formula": {
    "distribution": "NONCENTRAL_T_ITERATIVE",
    "not_z_approximation": true,
    "formula": "solve n such that power(n, alpha_per_test, sigma_d, MDE) >= 0.80 using noncentral t with df=n-1",
    "sigma_estimator": "FORMAL_GROUP_MEAN_VARIANCE_FROM_CALIBRATION_MIXED_MODEL",
    "alpha_per_test": 0.01,
    "minimum_per_stratum": 8,
    "maximum_per_stratum": 16,
    "formula_result_below_min": "USE_MINIMUM_8_AND_REPORT_VARIANCE_UNCERTAINTY",
    "if_budget_cannot_support_minimum": "NOT_FEASIBLE",
    "if_required_above_max": "STOP_OR_M1_ACCEPTS_UNDERPOWERED",
    "final_rule": "N = clamp(ceil(n_required), 8, 16) per stratum; no value below 8",
    "no_optional_stopping": true,
    "no_mid_campaign_extension": true,
    "no_mid_campaign_reduction": true,
    "contrast_family": "A1_vs_A0,A3_vs_A0,DVA_vs_A0,A3_vs_A1,DVA_vs_A3",
    "system_context_separate": true
  },
  "formal_runs": {
    "strata": 2,
    "systems": 6,
    "repeats": 2,
    "groups_formula": "2 * N",
    "runs_formula": "2 * N * 6 * 2",
    "runs_at_min": 192,
    "runs_at_target": 288,
    "runs_at_max": 384,
    "total_campaign_runs_at_min": 336,
    "total_campaign_runs_at_target": 432,
    "total_campaign_runs_at_max": 528
  },
  "resource_budget": {
    "gpu_class": "NVIDIA GeForce RTX 4090 D",
    "gpu_memory_gib": 24,
    "minimum_gpu_hours": 72,
    "maximum_gpu_hours": 112,
    "projection_formula": "1.2 * (144 * calibration_p95_seconds + formal_runs * formal_p95_seconds) / 3600",
    "calibration_run_p95_seconds": "MEASURED_DURING_CALIBRATION",
    "formal_run_p95_seconds": "CALIBRATION_P95_PLUS_DECLARED_SYSTEM_OVERHEAD",
    "overhead_factor": 1.2,
    "overhead_includes": [
      "ENGINE_STARTUP",
      "PROCESS_RESTART",
      "ARCHIVE_IO",
      "EVALUATION",
      "ONE_FAILURE_RESERVE"
    ],
    "per_run_timeout_seconds": 600,
    "shutdown_grace_seconds": 60,
    "reservation_window_seconds": 1800,
    "if_projected_above_maximum": "STOP_AND_RETURN_TO_M1; DO_NOT_AUTO_REDUCE_N",
    "if_projected_below_minimum_sample": "NOT_FEASIBLE",
    "no_gpu_run_below_minimum_n": true,
    "minimum_runs": 336,
    "maximum_runs": 528,
    "if_power_requires_more_than_budget": "M1_DECISION_REQUIRED; NO_AUTO_REDUCTION"
  },
  "analysis_contract": {
    "independent_unit": "WORKLOAD_GROUP",
    "paired_by_group": true,
    "strata": "REPORT_SEPARATELY_AND_COMBINE_BY_FIXED_WEIGHT",
    "primary_family": [
      "A1_vs_A0",
      "A3_vs_A0",
      "DVA_vs_A0",
      "A3_vs_A1",
      "DVA_vs_A3"
    ],
    "primary_test": "PAIRED_GROUP_PERMUTATION_AND_T_WITH_BOOTSTRAP_CI",
    "confidence_interval": "GROUP_BOOTSTRAP_95_PERCENT",
    "bootstrap_resamples": 10000,
    "bootstrap_seed": 20261201,
    "secondary_family": "BH_FDR_0_05_EXPLORATORY",
    "missing_policy": "COMPLETE_CASE_GROUP_NO_IMPUTATION",
    "sensitivity": [
