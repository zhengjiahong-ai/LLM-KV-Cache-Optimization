{
  "schema_version": "phase5.calibration_sample_size.v1",
  "protocol_id": "phase5-formal-six-system-trace-replay-v1",
  "status": "DESIGN_ONLY_CALIBRATION_NOT_EXECUTED",
  "calibration": {
    "purpose": "estimate Group-level paired-difference variance and within-Group repeat noise; never estimate the formal treatment effect",
    "groups_per_stratum": 4,
    "strata": 2,
    "systems": 6,
    "repeats": 3,
    "runs_total": 144,
    "disjoint_from_formal": true,
    "reuse_as_formal_evidence": false,
    "selection": "PRE_REGISTERED_BEFORE_OUTCOMES"
  },
  "variance_model": {
    "group_level_random_effect": "b_g",
    "repeat_noise": "epsilon_g_r",
    "model": "d_g_r = mu + b_g + epsilon_g_r",
    "between_group_variance": "sigma_between^2",
    "within_group_repeat_variance": "sigma_repeat^2",
    "calibration_group_level_estimate": "mean over repeats of d_g_r",
    "formal_group_mean_variance": "sigma_between^2 + sigma_repeat^2 / formal_repeats",
    "estimator": "method_of_moments_mixed_model",
