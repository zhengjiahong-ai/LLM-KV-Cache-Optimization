      "CENSORED_VS_NONCENSORED",
      "ARRIVAL_REALIZATION",
      "OFFICIAL_ENVIRONMENT_COMPATIBLE",
      "REPEAT_AGGREGATION"
    ],
    "primary_system_context_family": [
      "NATIVE_vs_A0",
      "OFFICIAL_vs_A0"
    ],
    "families_per_stratum": 2,
    "family_multiplicity": "HOLM_WITHIN_EACH_FAMILY",
    "merged_strata_primary": false
  },
  "stop_rules": [
    "CALIBRATION_INCOMPLETE",
